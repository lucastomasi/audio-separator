#!/bin/bash
# Double-click entry for Audio Separator.app.
# Canned zip: uses bundled venvs. Git checkout / incomplete zip: creates them.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
DATA="${HOME}/Library/Application Support/Audio Separator"
LOG_DIR="${HOME}/Library/Logs/Audio Separator"
mkdir -p "$DATA" "$LOG_DIR"
LOG="$LOG_DIR/launch.log"

log() {
  echo "[launcher $(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG" 2>/dev/null || true
}

die() {
  log "ERROR: $*"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display dialog \"$*\" with title \"Audio Separator\" buttons {\"OK\"} default button \"OK\"" >/dev/null 2>&1 || true
  fi
  exit 1
}

APPDIR=""
VENV=""
VENV_VC=""
BIN=""
MODE=""

if [[ -f "$HERE/../Resources/app/desktop.py" ]]; then
  CONTENTS="$(cd "$HERE/.." && pwd)"
  APPDIR="$CONTENTS/Resources/app"
  VENV="$CONTENTS/Resources/venv"
  VENV_VC="$CONTENTS/Resources/venv-vc"
  BIN="$CONTENTS/Resources/bin"
  MODE="bundle"
elif [[ "$(basename "$HERE")" == "MacOS" ]]; then
  APP_BUNDLE="$(cd "$HERE/../.." && pwd)"
  REPO="$(cd "$APP_BUNDLE/.." && pwd)"
  if [[ -f "$REPO/desktop.py" ]]; then
    APPDIR="$REPO"
    VENV="$APPDIR/.venv"
    VENV_VC="$APPDIR/.venv-vc"
    MODE="repo"
  fi
elif [[ -f "$HERE/../desktop.py" ]]; then
  APPDIR="$(cd "$HERE/.." && pwd)"
  VENV="$APPDIR/.venv"
  VENV_VC="$APPDIR/.venv-vc"
  MODE="scripts"
fi

[[ -n "$APPDIR" && -f "$APPDIR/desktop.py" ]] || \
  die "No encuentro desktop.py. Dejá Audio Separator.app junto al repo, o usá el zip standalone."

log "mode=$MODE appdir=$APPDIR"

BOOTSTRAP="$APPDIR/scripts/bootstrap_macos.sh"
if [[ ! -x "$BOOTSTRAP" && -f "$BOOTSTRAP" ]]; then
  chmod +x "$BOOTSTRAP" || true
fi

probe() {
  local py="$1"
  local expr="$2"
  [[ -x "$py" ]] && "$py" -c "$expr" >/dev/null 2>&1
}

need_bootstrap=0
if ! probe "$VENV/bin/python" "import gradio, torch, webview"; then
  need_bootstrap=1
fi
if ! probe "$VENV_VC/bin/python" "import torch, transformers, librosa"; then
  need_bootstrap=1
fi

if [[ "$need_bootstrap" -eq 1 ]]; then
  if [[ "$MODE" == "bundle" && ! -w "$(dirname "$VENV")" ]]; then
    VENV="$DATA/venv"
    VENV_VC="$DATA/venv-vc"
    log "Resources no escribible; venvs en $DATA"
  fi
  [[ -x "$BOOTSTRAP" ]] || die "Falta scripts/bootstrap_macos.sh"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'display notification "Instalando dependencias (primera vez)…" with title "Audio Separator"' >/dev/null 2>&1 || true
  fi
  log "bootstrap root=$APPDIR app=$VENV vc=$VENV_VC"
  bash "$BOOTSTRAP" --root "$APPDIR" --app-venv "$VENV" --vc-venv "$VENV_VC" --log "$LOG"
fi

[[ -x "$VENV/bin/python" ]] || die "No está el Python de la app en $VENV"
[[ -f "$APPDIR/desktop.py" ]] || die "Falta desktop.py"

LAUNCH_PATH="${VENV}/bin"
if [[ -n "$BIN" ]]; then
  LAUNCH_PATH="$LAUNCH_PATH:$BIN"
fi
LAUNCH_PATH="$LAUNCH_PATH:/usr/local/bin:/Library/Frameworks/Python.framework/Versions/3.12/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

exec /usr/bin/env -i \
  HOME="$HOME" \
  USER="${USER:-}" \
  LOGNAME="${LOGNAME:-${USER:-}}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  LANG="en_US.UTF-8" \
  LC_ALL="en_US.UTF-8" \
  PATH="$LAUNCH_PATH" \
  VIRTUAL_ENV="$VENV" \
  PYTHONNOUSERSITE=1 \
  PYTHONUNBUFFERED=1 \
  AUDIO_SEPARATOR_HOME="$APPDIR" \
  AUDIO_SEPARATOR_DATA="$DATA" \
  AUDIO_SEPARATOR_HOST=127.0.0.1 \
  AUDIO_SEPARATOR_PORT=7860 \
  AUDIO_SEPARATOR_VC_PYTHON="$VENV_VC/bin/python" \
  "$VENV/bin/python" -u "$APPDIR/desktop.py"
